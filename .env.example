# -----------------------------------------------------------------------------
# Gisst - environment configuration
# Copy to `.env` and fill in. Only TELEGRAM_BOT_TOKEN is strictly required to
# start the bot; Notion + the API dashboard are optional and degrade gracefully.
# -----------------------------------------------------------------------------

# === Runtime mode ===
GISST_ENV=dev                        # dev | prod - controls log format + verbosity

# === Telegram (required) ===
TELEGRAM_BOT_TOKEN=                   # from @BotFather

# === Agent runtime ===
# Backend that actually drives Claude:
#   cli  - shell out to the Claude Code CLI (`claude -p`, session via --resume)
#   api  - native Anthropic SDK agent loop (WebSearch/WebFetch tool-use)
AGENT_BACKEND=cli
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=                    # required only when AGENT_BACKEND=api
AGENT_TIMEOUT=300                     # seconds per agent run
AGENT_MAX_TURNS=12                    # max tool-use turns for the api backend
GISST_WORK_DIR=                       # cwd the agent operates in (default: ./data/workspace)
GISST_DATA_DIR=                       # root for JSON store + sqlite (default: ./data)

# === Persistence ===
DATABASE_URL=sqlite+aiosqlite:///./data/gisst.db

# === Notion knowledge base (optional) ===
NOTION_API_KEY=
NOTION_PAGE_ID=                       # parent page; databases are auto-provisioned under it
NOTION_RESEARCH_DB_ID=                # auto-filled after first boot
NOTION_DIGEST_DB_ID=                  # auto-filled after first boot
NOTION_VERSION=2022-06-28

# === Scheduler (Watchout Protocol) ===
SCHEDULER_TICK_SECONDS=60
SCHEDULER_ENABLED=true

# === API dashboard (optional) ===
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000

# === Observability ===
LOG_LEVEL=INFO
LOG_JSON=false                        # true -> JSON logs (prod); false -> pretty console (dev)
